# MCP environment variable example.
# Copy this file to .env and fill in only the credentials you need.
#
# macOS / Linux:
#   cp .env.example .env
#
# Windows:
#   copy .env.example .env
#
# Do not commit .env or real API keys.

# Context7: library/framework/SDK documentation lookup.
# https://context7.com/dashboard
CONTEXT7_API_KEY=your_context7_api_key

# Tavily: web search and deep research.
# https://app.tavily.com/home
TAVILY_API_KEY=your_tavily_api_key

# Brave Search: independent search index.
# https://api.search.brave.com/app/keys
BRAVE_API_KEY=your_brave_api_key

# Optional Augment Context Engine credentials.
ACE_TOKEN=your_ace_token
ACE_RELAY_URL=your_ace_relay_url
