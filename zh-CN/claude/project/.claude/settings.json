{
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "enableAllProjectMcpServers": false,
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.development)",
      "Read(./.env.test)",
      "Read(./.env.staging)",
      "Read(./.env.production)",
      "Read(./.env.*.local)",
      "Read(./secrets/**)"
    ],
    "ask": [
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git tag *)",
      "Bash(npm publish *)",
      "Bash(rm *)",
      "PowerShell(git commit *)",
      "PowerShell(git push *)",
      "PowerShell(git tag *)",
      "PowerShell(npm publish *)",
      "PowerShell(Remove-Item *)"
    ]
  }
}
